# FCIS - Backend Environment Variables (Template / Example)
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your_fcis_secret_key_here
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# AI Provider Configuration (Store your actual secret in .env - DO NOT COMMIT .env)
AI_API_KEY=your_google_gemini_api_key_here
AI_MODEL=gemini-3.1-flash-lite
